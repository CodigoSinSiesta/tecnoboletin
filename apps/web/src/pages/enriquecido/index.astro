---
import { readFile, readdir } from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { date } = Astro.params;
const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.replace(/\/?$/, '/');

// Directorio de la fuente de datos: apps/web/src/data/boletines/
const dataDir = path.join(process.cwd(), 'src', 'data', 'boletines');
const entries = await readdir(dataDir, { withFileTypes: true });
const dates = entries
  .filter((e) => e.isDirectory() && /^\d{4}-\d{2}-\d{2}$/.test(e.name))
  .map((e) => e.name)
  .sort()
  .reverse();

// Por cada fecha, leemos el enriched para sacar items_count y resumen
const resumenes: Record<string, { items: number; resumen: string; temas: string[] }> = {};
for (const d of dates) {
  try {
    const e = JSON.parse(await readFile(path.join(dataDir, d, 'enriched.json'), 'utf-8'));
    const items = e.items || [];
    resumenes[d] = {
      items: items.length,
      resumen: (e.resumen_ejecutivo || '').slice(0, 240),
      temas: [...new Set(items.map((it: any) => it.clasificacion?.tema_principal).filter(Boolean))] as string[],
    };
  } catch {}
}
---
<BaseLayout title="Boletines enriquecidos">
  <header class="mb-10 pb-6 border-b border-[var(--color-border)]">
    <h1 class="font-serif text-3xl mb-3">Boletines enriquecidos</h1>
    <p class="text-muted max-w-2xl">
      Los ultimos {dates.length} boletines, procesados con la skill <code>tecnoboletin-enricher</code>. Cada item esta clasificado (tipo, idioma, tema) y revisado por 3 perfiles sinteticos (teatro). La web publica viene del repo <code>CodigoSinSiesta/tecnoboletin</code> en GitHub Pages.
    </p>
  </header>

  <div class="space-y-4">
    {dates.map((d) => (
      <a
        href={`${base}enriquecido/${d}/`}
        class="block border border-[var(--color-border)] rounded-lg p-5 bg-[var(--color-surface)] hover:border-[var(--color-accent)] transition"
      >
        <header class="flex items-center justify-between mb-2">
          <time class="font-mono">{d}</time>
          <span class="text-xs text-muted">{resumenes[d]?.items || 0} items</span>
        </header>
        <p class="text-sm text-text mb-2">{resumenes[d]?.resumen || '(sin resumen)'}</p>
        <div class="flex flex-wrap gap-2 text-xs">
          {(resumenes[d]?.temas || []).slice(0, 8).map((t) => (
            <span class="px-2 py-0.5 bg-[var(--color-bg)] rounded">#{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>

  <footer class="mt-16 pt-6 border-t border-[var(--color-border)] text-xs text-muted">
    <a href={base}>&larr; Inicio</a>
  </footer>
</BaseLayout>
