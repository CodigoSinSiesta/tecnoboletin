---
import { readFile, readdir } from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.replace(/\/?$/, '/');

// Directorio de la fuente de datos: apps/web/src/data/boletines/
const dataDir = path.join(process.cwd(), 'src', 'data', 'boletines');
const entries = await readdir(dataDir, { withFileTypes: true });
const dates = entries
  .filter((e) => e.isDirectory() && /^\d{4}-\d{2}-\d{2}$/.test(e.name))
  .map((e) => e.name)
  .sort()
  .reverse();

// Por cada fecha, leemos el enriched para sacar items_count y resumen
const resumenes: Record<string, { items: number; hallazgos: number; resumen: string; temas: string[] }> = {};
for (const d of dates) {
  try {
    const e = JSON.parse(await readFile(path.join(dataDir, d, 'enriched.json'), 'utf-8'));
    const items = e.items || [];
    resumenes[d] = {
      items: items.length,
      hallazgos: items.filter((it: any) => it.seccion === 'hallazgo_principal').length,
      resumen: (e.resumen_ejecutivo || '').slice(0, 240),
      temas: [...new Set(items.map((it: any) => it.clasificacion?.tema_principal).filter(Boolean))] as string[],
    };
  } catch {}
}
---
<BaseLayout title="Boletines enriquecidos" activeNav="enriquecido">
  <header class="mb-12 pb-8 border-b border-border">
    <p class="font-display text-xs uppercase tracking-[0.14em] text-accent mb-3 font-semibold">Índice</p>
    <h1 class="font-display font-extrabold mb-4" style="font-size: clamp(2rem, 5vw, 3rem);">Boletines enriquecidos</h1>
    <p class="prose-card text-muted">
      Los últimos {dates.length} boletines, procesados con la skill <code class="font-mono text-sm bg-surface px-1.5 py-0.5 rounded">tecnoboletin-enricher</code>.
      Cada hallazgo conserva su "por qué importa" y su relación con el grafo de conocimiento tal como
      se escribieron en el boletín origen, pulidos y cruzados contra el historial acumulado — tipo,
      tema y confianza quedan como metadata secundaria. La web pública viene del repo
      <code class="font-mono text-sm bg-surface px-1.5 py-0.5 rounded">CodigoSinSiesta/tecnoboletin</code> en GitHub Pages.
    </p>
  </header>

  <div class="space-y-4">
    {dates.map((d, i) => (
      <a
        href={`${base}enriquecido/${d}/`}
        class="zine-card p-5 md:p-6 flex gap-5 hover:border-accent transition-colors"
        style="--rail-color: var(--color-accent);"
      >
        <div class="zine-num zine-num--radar shrink-0 hidden sm:block" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </div>
        <div class="min-w-0 flex-1">
          <header class="flex items-center justify-between mb-2 gap-3 flex-wrap">
            <time class="font-display font-semibold text-text">{d}</time>
            <span class="badge badge--solid-accent">{resumenes[d]?.hallazgos || 0} hallazgos</span>
          </header>
          <p class="prose-card text-sm text-muted mb-3">{resumenes[d]?.resumen || '(sin resumen)'}</p>
          <div class="flex flex-wrap gap-2 text-xs">
            {(resumenes[d]?.temas || []).slice(0, 8).map((t) => (
              <span class="badge badge--ghost">#{t}</span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>

  <footer class="mt-16 pt-6 border-t border-border text-xs text-muted-dim">
    <a href={base} class="hover:text-text">&larr; Inicio</a>
  </footer>
</BaseLayout>
