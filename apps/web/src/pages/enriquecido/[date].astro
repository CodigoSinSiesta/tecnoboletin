---
/**
 * Permalink de cada boletín. Todo el render vive en `BoletinEnriquecido`,
 * compartido con `/hoy/`.
 */
import BoletinEnriquecido from '../../components/BoletinEnriquecido.astro';
import { listDates } from '../../lib/boletin';

export async function getStaticPaths() {
  const dates = await listDates();
  return dates.map((date) => ({ params: { date } }));
}

const { date } = Astro.params;
---
<BoletinEnriquecido date={date!} activeNav="archivo" />
