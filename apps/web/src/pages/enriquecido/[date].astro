---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const { default: fs } = await import('node:fs/promises');
  const base = path.join(process.cwd(), 'src', 'data', 'boletines');
  const entries = await fs.readdir(base, { withFileTypes: true });
  return entries
    .filter((e) => e.isDirectory() && /^\d{4}-\d{2}-\d{2}$/.test(e.name))
    .map((e) => ({ params: { date: e.name } }));
}

const { date } = Astro.params;
const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.replace(/\/?$/, '/');
const dataBase = path.join(process.cwd(), 'src', 'data', 'boletines', date);

let enriched: any = null;
let edges: any[] = [];
let editorial: any = null;
try {
  enriched = JSON.parse(await readFile(path.join(dataBase, 'enriched.json'), 'utf-8'));
} catch {}
try {
  edges = (await readFile(path.join(dataBase, 'edges.jsonl'), 'utf-8'))
    .split('\n').filter(Boolean).map((l: string) => JSON.parse(l));
} catch {}
try {
  editorial = JSON.parse(await readFile(path.join(dataBase, 'editorial.json'), 'utf-8'));
} catch {}

const items: any[] = enriched?.items || [];
const hallazgos = items.filter((it) => it.seccion === 'hallazgo_principal');
const radar = items.filter((it) => it.seccion === 'radar_secundario');

// Cruce editorial: los idx que editorial.acciones_concretas marca como "explora"
// son la senal editorial mas fuerte que ya existe en los datos -- se usan para
// dar a esos hallazgos un tratamiento visual "pick" por encima del resto.
const pickIdx = new Set(
  (editorial?.acciones_concretas || [])
    .filter((a: any) => a.tipo === 'explora')
    .map((a: any) => a.item_idx)
);

// contenido.accion_sugerida es texto libre e inconsistente del enriquecedor:
// "explorar -- ...", "**explorar**", ": vigilar", "sugerida: vigilar",
// "sugerida: probar -- ...", "**leer**." etc. normalizeAccion() quita
// markdown/puntuacion y el prefijo literal "sugerida:" antes de extraer el
// verbo, para que el badge use siempre un color semantico correcto.
type AccionKind = 'go' | 'radar' | 'accent' | 'ignorar' | null;
function normalizeAccion(raw: string): string {
  let t = (raw || '').trim();
  t = t.replace(/^[*_~`\s:.-]+/, '');
  t = t.replace(/^sugerida\s*:?\s*/i, '');
  t = t.replace(/^[*_~`\s:.-]+/, '');
  return t;
}
function accionKind(raw: string): AccionKind {
  const t = normalizeAccion(raw).toLowerCase();
  if (t.startsWith('explorar') || t.startsWith('explora') || t.startsWith('probar')) return 'go';
  if (t.startsWith('leer')) return 'radar';
  if (t.startsWith('vigilar')) return 'accent';
  if (t.startsWith('ignorar')) return 'ignorar';
  return null;
}
function accionVerb(raw: string): string {
  const t = normalizeAccion(raw);
  const m = t.match(/^[a-záéíóúñ]+/i);
  return m ? m[0].toLowerCase() : 'nota';
}
// Resto del texto tras el verbo, para no duplicar "EXPLORAR" (badge) seguido
// de "**explorar** - ..." (detalle) cuando el string original solo era el verbo.
function accionDetail(raw: string): string {
  let t = normalizeAccion(raw);
  const m = t.match(/^[a-záéíóúñ]+/i);
  if (m) t = t.slice(m[0].length);
  t = t.replace(/^[*_~`\s:.—-]+/, '');
  t = t.replace(/[*_~`\s]+$/, '');
  return t.trim();
}
const accionBadgeClass: Record<string, string> = {
  go: 'badge--solid-go',
  radar: 'badge--solid-radar',
  accent: 'badge--solid-accent',
  ignorar: 'badge--outline',
  ghost: 'badge--ghost',
};
---
<BaseLayout title={`Tecnoboletin ${date}`} activeNav="enriquecido">
  <header class="mb-12 pb-8 border-b border-border">
    <div class="flex flex-wrap items-end gap-x-8 gap-y-4 mb-5">
      <div class="font-display leading-none" style="font-size: clamp(2.5rem, 7vw, 4.5rem); font-weight: 800;">
        {date}
      </div>
      <div class="flex gap-2 pb-1">
        <span class="badge badge--solid-accent">{hallazgos.length} hallazgos</span>
        <span class="badge badge--solid-radar">{radar.length} radar</span>
      </div>
    </div>
    {enriched?.resumen_ejecutivo && (
      <p class="prose-card text-muted whitespace-pre-wrap">{enriched.resumen_ejecutivo}</p>
    )}
  </header>

  {editorial && (
    <section class="mb-14">
      <div class="section-rule" style="--rule-color: var(--color-violet);">
        <span class="section-rule__label text-violet">Lectura editorial</span>
      </div>
      <div class="zine-card p-6 md:p-8" style="--rail-color: var(--color-violet); background: linear-gradient(160deg, var(--color-surface-2), var(--color-surface));">
        <p class="text-xs text-muted-dim mb-6 max-w-prose">
          Síntesis del boletín: posicionamiento, convergencia con el stack local-first, cruce con el
          grafo de conocimiento y tendencias entre boletines.
        </p>

        <div class="grid md:grid-cols-2 gap-x-10 gap-y-6">
          {editorial.posicionamiento && (
            <article>
              <h3 class="font-display text-xs uppercase tracking-wider text-violet mb-2 font-semibold">Posicionamiento</h3>
              <p class="text-base text-text whitespace-pre-wrap prose-card">{editorial.posicionamiento}</p>
            </article>
          )}

          {editorial.convergencia_stack_css && (
            <article>
              <h3 class="font-display text-xs uppercase tracking-wider text-violet mb-2 font-semibold">Convergencia con tu stack</h3>
              <p class="text-base text-text whitespace-pre-wrap prose-card">{editorial.convergencia_stack_css}</p>
            </article>
          )}

          {editorial.cruzado_grafo && (
            <article>
              <h3 class="font-display text-xs uppercase tracking-wider text-violet mb-2 font-semibold">Cruzado con tu grafo</h3>
              <p class="text-base text-text whitespace-pre-wrap prose-card">{editorial.cruzado_grafo}</p>
            </article>
          )}

          {editorial.tendencias_5_boletines && (
            <article>
              <h3 class="font-display text-xs uppercase tracking-wider text-violet mb-2 font-semibold">Tendencias (5-6 boletines)</h3>
              <p class="text-base text-text whitespace-pre-wrap prose-card">{editorial.tendencias_5_boletines}</p>
            </article>
          )}
        </div>

        {editorial.alertas && editorial.alertas.length > 0 && (
          <article class="mt-8 pt-6 border-t border-border">
            <h3 class="font-display text-xs uppercase tracking-wider text-alert mb-3 font-semibold">Alertas honestas</h3>
            <ul class="space-y-2">
              {editorial.alertas.map((a: string) => (
                <li class="alert-callout text-base text-text">{a}</li>
              ))}
            </ul>
          </article>
        )}

        {editorial.acciones_concretas && editorial.acciones_concretas.length > 0 && (
          <article class="mt-8 pt-6 border-t border-border">
            <h3 class="font-display text-xs uppercase tracking-wider text-muted mb-3 font-semibold">Acciones concretas</h3>
            <div class="grid sm:grid-cols-2 gap-3">
              {editorial.acciones_concretas.map((a: any) => (
                <div class="border border-border rounded-lg p-3 bg-bg">
                  <div class="flex items-center gap-2 mb-2">
                    <span class={`badge ${
                      a.tipo === 'explora' ? 'badge--solid-go' :
                      a.tipo === 'vigilar' ? 'badge--solid-accent' :
                      'badge--solid-radar'
                    }`}>{a.tipo}</span>
                    <span class="text-xs text-muted-dim font-mono">item #{a.item_idx}</span>
                  </div>
                  <p class="text-base text-text">{a.razon}</p>
                </div>
              ))}
            </div>
          </article>
        )}
      </div>
    </section>
  )}

  <section class="mb-14">
    <div class="section-rule" style="--rule-color: var(--color-accent);">
      <span class="section-rule__label text-accent">Hallazgos principales</span>
    </div>
    <div class="space-y-5">
      {hallazgos.map((it, i) => {
        const isPick = pickIdx.has(it.idx);
        const kind = it.contenido?.accion_sugerida ? accionKind(it.contenido.accion_sugerida) : null;
        return (
          <article
            class:list={['zine-card p-5 md:p-6', isPick && 'zine-card--pick']}
            style="--rail-color: var(--color-accent);"
          >
            <div class="flex gap-4 md:gap-5">
              <div class="zine-num shrink-0 hidden sm:block" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </div>
              <div class="min-w-0 flex-1">
                <header class="flex items-start justify-between mb-2 gap-3 flex-wrap">
                  <h3 class="font-display text-lg font-semibold">
                    <a href={it.url} target="_blank" rel="noopener" class="text-text hover:text-accent">{it.titulo}</a>
                    {isPick && <span class="badge badge--solid-accent ml-2 align-middle">pick editorial</span>}
                  </h3>
                  <div class="flex items-center gap-2 text-xs shrink-0">
                    <span class="badge badge--ghost">{it.clasificacion?.tipo}</span>
                    <span class="badge badge--ghost">{it.clasificacion?.tema_principal}</span>
                    <span class="text-muted-dim font-mono">{Number(it.clasificacion?.confianza ?? 0).toFixed(2)}</span>
                  </div>
                </header>

                {it.contenido?.que_es && (
                  <p class="prose-card text-base text-text mb-3">{it.contenido.que_es}</p>
                )}

                {it.contenido?.por_que_importa && (
                  <div class="mb-3">
                    <h4 class="font-display text-xs uppercase tracking-wider text-muted mb-1 font-semibold">Por qué importa</h4>
                    <p class="prose-card text-base text-text">{it.contenido.por_que_importa}</p>
                  </div>
                )}

                {it.contenido?.madurez_senales && (
                  <p class="prose-card text-xs text-muted-dim mb-3">{it.contenido.madurez_senales}</p>
                )}

                {it.relacion_grafo && it.relacion_grafo.length > 0 && (
                  <div class="mb-3">
                    <h4 class="font-display text-xs uppercase tracking-wider text-muted mb-1 font-semibold">Relación con el grafo</h4>
                    <ul class="text-xs font-mono text-muted-dim space-y-1">
                      {it.relacion_grafo.map((t: any) => (
                        <li>
                          {t.src} <span class="text-radar">--[{t.rel}]--&gt;</span> {t.dst}
                          {t.primera_mencion && <span class="text-muted not-italic font-sans"> (ya cubierto el {t.primera_mencion})</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {it.contenido?.accion_sugerida && (
                  <div class="flex items-start gap-2 flex-wrap mt-3">
                    <span class={`badge ${accionBadgeClass[kind ?? 'ghost']}`}>
                      {accionVerb(it.contenido.accion_sugerida)}
                    </span>
                    {accionDetail(it.contenido.accion_sugerida) && (
                      <span class="text-xs text-muted-dim">{accionDetail(it.contenido.accion_sugerida)}</span>
                    )}
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  {radar.length > 0 && (
    <section class="mb-14">
      <div class="section-rule" style="--rule-color: var(--color-radar);">
        <span class="section-rule__label text-radar">Radar secundario</span>
      </div>
      <div class="space-y-3">
        {radar.map((it) => {
          const kind = it.contenido?.accion_sugerida ? accionKind(it.contenido.accion_sugerida) : null;
          return (
            <article class="zine-card p-4" style="--rail-color: var(--color-radar);">
              <div class="flex items-center justify-between gap-3 mb-1 flex-wrap">
                <a href={it.url} target="_blank" rel="noopener" class="font-mono text-text hover:text-radar">{it.titulo}</a>
                {it.contenido?.accion_sugerida && (
                  <span class={`badge ${accionBadgeClass[kind ?? 'ghost']}`}>
                    {accionVerb(it.contenido.accion_sugerida)}
                  </span>
                )}
              </div>
              {it.contenido?.que_es && <p class="prose-card text-text">{it.contenido.que_es}</p>}
              {it.contenido?.madurez_senales && <p class="prose-card text-xs text-muted-dim mt-1">{it.contenido.madurez_senales}</p>}
            </article>
          );
        })}
      </div>
    </section>
  )}

  {edges.length > 0 && (
    <details class="mb-14 zine-card p-5" style="--rail-color: var(--color-border-strong);">
      <summary class="font-display text-xs uppercase tracking-wider text-muted cursor-pointer font-semibold">
        Edges del grafo ({edges.length})
      </summary>
      <div class="space-y-1 mt-4">
        {edges.slice(0, 60).map((e) => (
          <div class="font-mono text-xs text-muted-dim">
            {e.src} <span class="text-radar">--[{e.rel}]--&gt;</span> {e.dst}
            {e.primera_mencion && <span> (ya cubierto el {e.primera_mencion})</span>}
          </div>
        ))}
        {edges.length > 60 && <p class="text-xs text-muted-dim mt-3">…y {edges.length - 60} edges más</p>}
      </div>
    </details>
  )}

  <footer class="mt-16 pt-6 border-t border-border text-xs text-muted-dim">
    <a href={`${base}enriquecido/`} class="hover:text-text">&larr; Volver al índice</a>
    {enriched?.boletin_origen && <span class="ml-3">&middot; Fuente: {enriched.boletin_origen}</span>}
  </footer>
</BaseLayout>
