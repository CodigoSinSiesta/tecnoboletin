---
/**
 * Boletín del día — dirección "Blueprint diario".
 *
 * Lectura editorial de 5 minutos: titular con la tesis del día, hallazgos
 * escaneables (estado + "por qué importa" recortado a 3 líneas) y el mapa
 * del grafo SIEMPRE a la vista en la columna derecha, que es lo que
 * conecta el boletín con el grafo sin cambiar de página.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GraphChips from '../../components/GraphChips.astro';
import StateBadge from '../../components/StateBadge.astro';
import { mdBlock, mdInline } from '../../lib/markdown';
import {
  accionDetail, accionEstado, ESTADO_TONE, fmtDateLong, fmtNum, itemTema, listDates,
  loadBoletin, parseSenales, repoSlug, senalesLine, titularYEntradilla,
} from '../../lib/boletin';
import { buildDayMap } from '../../lib/daymap';

export async function getStaticPaths() {
  const dates = await listDates();
  return dates.map((date) => ({ params: { date } }));
}

const { date } = Astro.params;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');

const boletin = await loadBoletin(date!);
const { enriched, editorial, edges, items, hallazgos, radar, pickIdx } = boletin;

const { titular, entradilla } = titularYEntradilla(editorial);
// Se conserva solo por la métrica «conceptos nuevos» de la cabecera: el
// mapa visual se retiró. Las dimensiones ya no pintan nada, pero
// buildDayMap las exige en su firma.
const dayMap = buildDayMap(items, { width: 314, height: 300, max: 6 });

const dates = await listDates();
const i = dates.indexOf(date!);
const anterior = i >= 0 && i < dates.length - 1 ? dates[i + 1] : null;
const siguiente = i > 0 ? dates[i - 1] : null;

const alertas = editorial?.alertas ?? [];
const acciones = editorial?.acciones_concretas ?? [];

// Bloques de la lectura editorial que NO caben en el hero (el hero ya usa
// `posicionamiento`). Se conservan íntegros, recortados a 3 líneas.
const bloquesEditorial = [
  { titulo: 'Convergencia con tu stack', texto: editorial?.convergencia_stack_css },
  { titulo: 'Cruzado con tu grafo', texto: editorial?.cruzado_grafo },
  { titulo: 'Tendencias (5-6 boletines)', texto: editorial?.tendencias_5_boletines },
].filter((b) => Boolean(b.texto));
---
<BaseLayout
  title={`Boletín ${date}`}
  description={titular ?? `Boletín enriquecido de Código Sin Siesta del ${date}`}
  activeNav={date === dates[0] ? 'hoy' : 'archivo'}
  width="wide"
  crumbs={[date!]}
>
  <article class="border border-border-strong rounded-2xl overflow-hidden bg-bg-raised shadow-[0_1px_3px_rgba(0,0,0,.3),0_8px_24px_rgba(0,0,0,.15)]">
    <div class="brand-rule"></div>

    <!-- ── Hero: la tesis del día ── -->
    <header class="hero-glow px-6 md:px-8 pt-8 pb-6 border-b border-border">
      <div class="flex items-start justify-between gap-6 flex-wrap mb-3.5">
        <p class="eyebrow">Boletín · {fmtDateLong(date!)}</p>
        <div id="user-actions" class="hidden gap-2" data-date={date}>
          <button id="btn-fav" type="button" class="pill pill--ghost">☆ Guardar</button>
          <button id="btn-read" type="button" class="pill pill--ghost">✓ Marcar leído</button>
        </div>
      </div>

      {titular ? (
        <h1
          class="font-display font-extrabold text-[clamp(1.5rem,2.4vw,2.1rem)] leading-[1.1] tracking-[-0.01em] text-text max-w-[820px] mb-3.5"
          set:html={mdInline(titular)}
        />
      ) : (
        <h1 class="font-display font-extrabold text-[clamp(1.5rem,2.4vw,2.1rem)] leading-[1.1] text-text mb-3.5">
          Boletín del {fmtDateLong(date!)}
        </h1>
      )}

      {entradilla && (
        <details class="expand mb-5 max-w-[700px]">
          <summary>
            <p class="clamp-3 prose-card text-body text-[0.969rem] leading-[1.6]" set:html={mdInline(entradilla)} />
            <span class="expand__more"></span>
          </summary>
        </details>
      )}

      <div class="flex flex-wrap gap-x-6 gap-y-2 items-center font-mono text-xs text-muted-dim">
        <span><span class="text-text text-[15px] font-semibold">{hallazgos.length}</span> hallazgos</span>
        <span class="text-border-strong" aria-hidden="true">·</span>
        <span><span class="text-text text-[15px] font-semibold">{radar.length}</span> radar</span>
        {pickIdx.size > 0 && (
          <>
            <span class="text-border-strong" aria-hidden="true">·</span>
            <span><span class="text-accent text-[15px] font-semibold">{pickIdx.size}</span> picks editoriales</span>
          </>
        )}
        {dayMap && dayMap.conceptosNuevos.length > 0 && (
          <>
            <span class="text-border-strong" aria-hidden="true">·</span>
            <span>
              <span class="text-accent-soft text-[15px] font-semibold">{dayMap.conceptosNuevos.length}</span>
              {' '}conceptos nuevos en el grafo
            </span>
          </>
        )}
        <a href={`${base}triaje/${date}/`} class="ml-auto pill pill--ghost">Abrir en triaje →</a>
      </div>
    </header>

    <!-- ── Cuerpo: hallazgos + columna de alertas ── -->
    <div class="grid lg:grid-cols-[1fr_316px] gap-6 px-6 md:px-8 py-7 items-start">
      <div class="flex flex-col gap-5 min-w-0" id="findings">
        <div class="section-rule mb-0" style="--rule-color: var(--color-accent);">
          <span class="section-rule__label">Hallazgos principales</span>
        </div>

        {hallazgos.map((it, n) => {
          const estado = accionEstado(it.contenido?.accion_sugerida);
          const tone = estado ? ESTADO_TONE[estado] : null;
          const sen = parseSenales(it.contenido?.madurez_senales);
          const meta = senalesLine(sen);
          const tema = itemTema(it);
          const slug = repoSlug(it);
          const conf = it.clasificacion?.confianza;
          const detalle = accionDetail(it.contenido?.accion_sugerida);
          return (
            <article class:list={['finding', pickIdx.has(it.idx) && 'finding--pick']} tabindex="-1" data-finding>
              <div class="finding__gutter">
                <span class="finding__num">{String(n + 1).padStart(2, '0')}</span>
                <span class="finding__spine" aria-hidden="true"></span>
                <span class:list={['dot', tone ? `dot--${tone}` : 'bg-border-strong']} title={estado ?? 'sin acción sugerida'}></span>
              </div>
              <div class="finding__body">
                <div class="flex items-center gap-2 flex-wrap mb-2.5">
                  <StateBadge estado={estado} />
                  {tema && <span class="badge badge--ghost font-mono">#{tema}</span>}
                  {conf != null && (
                    <span class="conf" title={`Confianza del clasificador: ${conf.toFixed(2)}`}>
                      conf
                      <span class="conf__track" aria-hidden="true">
                        {[0, 1, 2, 3, 4].map((s) => (
                          <span class:list={['conf__step', s < Math.round(conf * 5) && 'conf__step--on']}></span>
                        ))}
                      </span>
                      {conf.toFixed(2)}
                    </span>
                  )}
                  {pickIdx.has(it.idx) && <span class="badge badge--pick ml-auto">pick editorial</span>}
                </div>

                <h3 class="font-mono text-[1.063rem] font-semibold text-text mb-1">
                  {slug ? (
                    <a href={`${base}repo/${slug}/`} class="text-text hover:text-accent-soft">{it.titulo}</a>
                  ) : (
                    it.titulo
                  )}
                  {it.url && (
                    <a href={it.url} target="_blank" rel="noopener" class="text-accent-soft text-sm ml-1" title="Abrir la fuente original">↗</a>
                  )}
                </h3>

                {meta && <div class="font-mono text-[0.719rem] text-muted-dim mb-3">{meta}</div>}

                {it.contenido?.que_es && (
                  <p class="prose-card text-body text-[0.906rem] mb-3.5" set:html={mdInline(it.contenido.que_es)} />
                )}

                {it.contenido?.por_que_importa && (
                  <div class="why mb-3.5">
                    <div class="why__label">Por qué importa</div>
                    <details class="expand">
                      <summary>
                        <p class="clamp-3 prose-card text-text text-[0.906rem]" set:html={mdInline(it.contenido.por_que_importa)} />
                        <span class="expand__more"></span>
                      </summary>
                    </details>
                  </div>
                )}

                {detalle && (
                  <p class="prose-card text-xs text-muted-dim mb-3" set:html={mdInline(detalle)} />
                )}

                <GraphChips rels={it.relacion_grafo ?? []} />
              </div>
            </article>
          );
        })}

        {radar.length > 0 && (
          <section class="mt-2">
            <div class="section-rule" style="--rule-color: var(--color-border-strong);">
              <span class="section-rule__label text-muted">Radar secundario · {radar.length}</span>
            </div>
            <div class="grid sm:grid-cols-2 gap-2.5">
              {radar.map((it) => {
                const estado = accionEstado(it.contenido?.accion_sugerida);
                const tone = estado ? ESTADO_TONE[estado] : null;
                const sen = parseSenales(it.contenido?.madurez_senales);
                const slug = repoSlug(it);
                return (
                  <article class="card card--quiet px-3.5 py-3" data-finding tabindex="-1">
                    <div class="flex items-center gap-2 mb-1">
                      <span class:list={['dot w-1.5 h-1.5', tone ? `dot--${tone}` : 'bg-border-strong']} title={estado ?? 'sin acción sugerida'}></span>
                      {slug ? (
                        <a href={`${base}repo/${slug}/`} class="font-mono text-[0.813rem] text-text hover:text-accent-soft truncate">{it.titulo}</a>
                      ) : (
                        <span class="font-mono text-[0.813rem] text-text truncate">{it.titulo}</span>
                      )}
                      {sen.stars != null && (
                        <span class="ml-auto font-mono text-[0.656rem] text-muted-dim shrink-0">{fmtNum(sen.stars)}★</span>
                      )}
                    </div>
                    {it.contenido?.que_es && (
                      <p class="clamp-2 prose-card text-[0.781rem] leading-[1.45] text-muted" set:html={mdInline(it.contenido.que_es)} />
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        )}

        {bloquesEditorial.length > 0 && (
          <section class="mt-2">
            <div class="section-rule" style="--rule-color: var(--color-accent-deep);">
              <span class="section-rule__label text-accent-soft">Lectura editorial</span>
            </div>
            <div class="grid md:grid-cols-2 gap-x-8 gap-y-5 card p-5">
              {bloquesEditorial.map((b) => (
                <article>
                  <h3 class="font-display text-[0.688rem] uppercase tracking-[0.14em] text-accent-soft mb-2 font-bold">{b.titulo}</h3>
                  <details class="expand">
                    <summary>
                      <div class="clamp-3 prose-card text-[0.875rem] text-body" set:html={mdBlock(b.texto!)} />
                      <span class="expand__more"></span>
                    </summary>
                  </details>
                </article>
              ))}
            </div>
          </section>
        )}

        {enriched?.resumen_ejecutivo && (
          <details class="card p-5 mt-2">
            <summary class="font-display text-[0.688rem] uppercase tracking-[0.14em] text-muted cursor-pointer font-bold">
              Resumen ejecutivo del boletín origen
            </summary>
            <div class="prose-card text-body text-[0.875rem] mt-4" set:html={mdBlock(enriched.resumen_ejecutivo)} />
          </details>
        )}

        {edges.length > 0 && (
          <details class="card card--quiet p-5">
            <summary class="font-display text-[0.688rem] uppercase tracking-[0.14em] text-muted cursor-pointer font-bold">
              Edges del grafo ({edges.length})
            </summary>
            <div class="space-y-1 mt-4">
              {edges.slice(0, 60).map((e) => (
                <div class="font-mono text-xs text-muted-dim">
                  {e.src} <span class="text-accent-soft">--[{e.rel}]--&gt;</span> {e.dst}
                  {e.primera_mencion && <span> (ya cubierto el {e.primera_mencion})</span>}
                </div>
              ))}
              {edges.length > 60 && <p class="text-xs text-muted-dim mt-3">…y {edges.length - 60} edges más</p>}
            </div>
          </details>
        )}
      </div>

      <!-- ── Columna derecha: alertas y acciones ── -->
      <aside class="flex flex-col gap-3.5 lg:sticky lg:top-[68px]">
        {alertas.length > 0 && (
          <div class="callout" style="--rail: var(--color-alert);">
            <div class="callout__title">Alertas honestas · {alertas.length}</div>
            {alertas.slice(0, 2).map((a) => (
              <p class="prose-card text-[0.781rem] leading-[1.5] text-body mb-2 last:mb-0" set:html={mdInline(a)} />
            ))}
            {alertas.length > 2 && (
              <details class="expand mt-2">
                <summary>
                  <span class="expand__more"></span>
                </summary>
                {alertas.slice(2).map((a) => (
                  <p class="prose-card text-[0.781rem] leading-[1.5] text-body mt-2" set:html={mdInline(a)} />
                ))}
              </details>
            )}
          </div>
        )}

        {acciones.length > 0 && (
          <div class="card p-3.5">
            <div class="font-display text-[0.688rem] uppercase tracking-[0.14em] text-muted font-bold mb-2.5">Tu turno</div>
            <ul class="flex flex-col gap-2">
              {acciones.map((a) => {
                const item = items.find((it) => it.idx === a.item_idx);
                const tone = a.tipo === 'explora' ? 'go' : a.tipo === 'vigilar' ? 'warn' : 'read';
                return (
                  <li class="flex gap-2 text-[0.781rem] leading-[1.45] text-body">
                    <span class:list={['dot mt-1.5', `dot--${tone}`]} title={a.tipo}></span>
                    <span>
                      {item && <span class="font-mono text-text">{item.titulo}</span>}
                      <span class="prose-card inline" set:html={mdInline(item ? ` — ${a.razon}` : a.razon)} />
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <div class="px-6 md:px-8 py-3 border-t border-border flex items-center justify-between gap-4 mono-meta">
      <div class="flex gap-3">
        {anterior && <a href={`${base}enriquecido/${anterior}/`} class="hover:text-text">← {anterior}</a>}
        <a href={`${base}enriquecido/`} class="hover:text-text">Archivo</a>
        {siguiente && <a href={`${base}enriquecido/${siguiente}/`} class="hover:text-text">{siguiente} →</a>}
      </div>
      <span class="hidden sm:flex items-center gap-1.5">
        <span class="kbd">J</span><span class="kbd">K</span> navegar hallazgos
        {enriched?.boletin_origen && <span class="ml-3">· {enriched.boletin_origen}</span>}
      </span>
    </div>
  </article>
</BaseLayout>

<script>
  // Navegación J/K entre hallazgos: baja el coste de escanear el boletín
  // con el teclado, que es como se lee en escritorio. Se ignora mientras
  // se escribe en un campo, para no secuestrar la búsqueda del navegador.
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-finding]'));
  let cursor = -1;

  function focusCard(next: number) {
    if (!cards.length) return;
    cursor = Math.max(0, Math.min(cards.length - 1, next));
    const el = cards[cursor];
    el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    el.focus({ preventScroll: true });
  }

  document.addEventListener('keydown', (ev) => {
    const target = ev.target as HTMLElement | null;
    if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
    if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
    if (ev.key === 'j') { ev.preventDefault(); focusCard(cursor + 1); }
    if (ev.key === 'k') { ev.preventDefault(); focusCard(cursor - 1); }
  });
</script>

<script>
  // Acciones de usuario (favorito / leido). Solo se muestran con sesion
  // iniciada; sin sesion la pagina queda exactamente igual que antes.
  import { getSupabase, getSessionResilient } from '../../lib/supabase';

  const supabase = getSupabase();
  const actions = document.getElementById('user-actions');
  const btnFav = document.getElementById('btn-fav');
  const btnRead = document.getElementById('btn-read');
  const date = actions?.dataset.date ?? '';

  let favId: boolean = false;
  let isRead = false;

  function paint() {
    if (!btnFav || !btnRead) return;
    btnFav.textContent = favId ? '★ Guardado' : '☆ Guardar';
    btnFav.classList.toggle('text-accent', favId);
    btnRead.textContent = isRead ? '✓ Leído' : '✓ Marcar leído';
    btnRead.classList.toggle('text-go', isRead);
  }

  async function init() {
    const session = await getSessionResilient();
    if (!session || !actions) return;
    actions.classList.remove('hidden');
    actions.classList.add('flex');

    const [fav, read] = await Promise.all([
      supabase.from('user_favorites').select('id').eq('kind', 'boletin').eq('ref', date).maybeSingle(),
      supabase.from('user_reads').select('boletin_date').eq('boletin_date', date).maybeSingle(),
    ]);
    favId = Boolean(fav.data);
    isRead = Boolean(read.data);
    paint();

    btnFav?.addEventListener('click', async () => {
      if (favId) {
        await supabase.from('user_favorites').delete().eq('kind', 'boletin').eq('ref', date);
        favId = false;
      } else {
        await supabase.from('user_favorites').insert({ kind: 'boletin', ref: date, user_id: session.user.id });
        favId = true;
      }
      paint();
    });

    btnRead?.addEventListener('click', async () => {
      if (isRead) {
        await supabase.from('user_reads').delete().eq('boletin_date', date);
        isRead = false;
      } else {
        await supabase.from('user_reads').insert({ boletin_date: date, user_id: session.user.id });
        isRead = true;
      }
      paint();
    });
  }

  init();
</script>
