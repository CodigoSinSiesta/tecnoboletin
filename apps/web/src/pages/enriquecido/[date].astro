---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const { default: fs } = await import('node:fs/promises');
  const base = path.join(process.cwd(), 'src', 'data', 'boletines');
  const entries = await fs.readdir(base, { withFileTypes: true });
  return entries
    .filter((e) => e.isDirectory() && /^\d{4}-\d{2}-\d{2}$/.test(e.name))
    .map((e) => ({ params: { date: e.name } }));
}

const { date } = Astro.params;
const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.replace(/\/?$/, '/');
const dataBase = path.join(process.cwd(), 'src', 'data', 'boletines', date);

let enriched: any = null;
let edges: any[] = [];
let editorial: any = null;
try {
  enriched = JSON.parse(await readFile(path.join(dataBase, 'enriched.json'), 'utf-8'));
} catch {}
try {
  edges = (await readFile(path.join(dataBase, 'edges.jsonl'), 'utf-8'))
    .split('\n').filter(Boolean).map((l: string) => JSON.parse(l));
} catch {}
try {
  editorial = JSON.parse(await readFile(path.join(dataBase, 'editorial.json'), 'utf-8'));
} catch {}

const items: any[] = enriched?.items || [];
const hallazgos = items.filter((it) => it.seccion === 'hallazgo_principal');
const radar = items.filter((it) => it.seccion === 'radar_secundario');
const stats = enriched?.stats || {};

const accionColor = (a: string) => {
  const t = (a || '').toLowerCase();
  if (t.startsWith('explorar') || t.startsWith('leer') || t.startsWith('probar')) {
    return 'bg-[var(--color-accent)] text-black';
  }
  if (t.startsWith('ignorar')) return 'bg-[var(--color-bg)] text-muted';
  return 'bg-yellow-900/40 text-yellow-200';
};
---
<BaseLayout title={`Tecnoboletin ${date}`}>
  <header class="mb-10 pb-6 border-b border-[var(--color-border)]">
    <div class="text-xs text-muted mb-3 flex gap-4 flex-wrap">
      <time>{date}</time>
      <span>{hallazgos.length} hallazgos · {radar.length} radar</span>
    </div>
    <h1 class="font-serif text-3xl mb-3">Tecnoboletin {date}</h1>
    {enriched?.resumen_ejecutivo && <p class="text-muted whitespace-pre-wrap">{enriched.resumen_ejecutivo}</p>}
  </header>

  {editorial && (
    <section class="mb-12 border border-[var(--color-accent)] rounded-lg p-6 bg-[var(--color-surface)]">
      <header class="mb-5">
        <h2 class="font-sans text-sm uppercase tracking-wider mb-2">Lectura editorial</h2>
        <p class="text-xs text-muted">
          Sintesis del boletin: posicionamiento, convergencia con el stack local-first, cruce con el
          grafo de conocimiento y tendencias entre boletines.
        </p>
      </header>

      {editorial.posicionamiento && (
        <article class="mb-5">
          <h3 class="font-sans text-xs uppercase tracking-wider text-muted mb-2">Posicionamiento</h3>
          <p class="text-sm text-text whitespace-pre-wrap">{editorial.posicionamiento}</p>
        </article>
      )}

      {editorial.convergencia_stack_css && (
        <article class="mb-5">
          <h3 class="font-sans text-xs uppercase tracking-wider text-muted mb-2">Convergencia con tu stack</h3>
          <p class="text-sm text-text whitespace-pre-wrap">{editorial.convergencia_stack_css}</p>
        </article>
      )}

      {editorial.cruzado_grafo && (
        <article class="mb-5">
          <h3 class="font-sans text-xs uppercase tracking-wider text-muted mb-2">Cruzado con tu grafo</h3>
          <p class="text-sm text-text whitespace-pre-wrap">{editorial.cruzado_grafo}</p>
        </article>
      )}

      {editorial.tendencias_5_boletines && (
        <article class="mb-5">
          <h3 class="font-sans text-xs uppercase tracking-wider text-muted mb-2">Tendencias (5-6 boletines)</h3>
          <p class="text-sm text-text whitespace-pre-wrap">{editorial.tendencias_5_boletines}</p>
        </article>
      )}

      {editorial.alertas && editorial.alertas.length > 0 && (
        <article class="mb-5">
          <h3 class="font-sans text-xs uppercase tracking-wider text-muted mb-2">Alertas honestas</h3>
          <ul class="text-sm text-text space-y-2">
            {editorial.alertas.map((a: string) => (
              <li class="border-l-2 border-[var(--color-accent)] pl-3">· {a}</li>
            ))}
          </ul>
        </article>
      )}

      {editorial.acciones_concretas && editorial.acciones_concretas.length > 0 && (
        <article>
          <h3 class="font-sans text-xs uppercase tracking-wider text-muted mb-3">Acciones concretas</h3>
          <div class="space-y-3">
            {editorial.acciones_concretas.map((a: any) => (
              <div class="border border-[var(--color-border)] rounded p-3 bg-[var(--color-bg)]">
                <div class="flex items-center gap-3 mb-2">
                  <span class={
                    a.tipo === 'explora' ? 'px-2 py-0.5 bg-[var(--color-accent)] text-black rounded text-xs font-semibold' :
                    a.tipo === 'vigilar' ? 'px-2 py-0.5 bg-yellow-900/40 text-yellow-200 rounded text-xs font-semibold' :
                    'px-2 py-0.5 bg-blue-900/40 text-blue-200 rounded text-xs font-semibold'
                  }>{a.tipo}</span>
                  <span class="text-xs text-muted">item #{a.item_idx}</span>
                </div>
                <p class="text-sm text-text">{a.razon}</p>
              </div>
            ))}
          </div>
        </article>
      )}
    </section>
  )}

  <section class="mb-12">
    <h2 class="font-sans text-sm uppercase tracking-wider text-muted mb-4">Hallazgos principales</h2>
    <div class="space-y-6">
      {hallazgos.map((it) => (
        <article class="border border-[var(--color-border)] rounded-lg p-5 bg-[var(--color-surface)]">
          <header class="flex items-center justify-between mb-2 gap-3 flex-wrap">
            <h3 class="font-serif text-lg">
              <a href={it.url} target="_blank" rel="noopener">{it.titulo}</a>
            </h3>
            <div class="flex items-center gap-2 text-xs shrink-0">
              <span class="px-2 py-0.5 bg-[var(--color-bg)] rounded text-muted">{it.clasificacion?.tipo}</span>
              <span class="px-2 py-0.5 bg-[var(--color-bg)] rounded text-muted">{it.clasificacion?.tema_principal}</span>
              <span class="text-muted">confianza {Number(it.clasificacion?.confianza ?? 0).toFixed(2)}</span>
            </div>
          </header>

          {it.contenido?.que_es && (
            <p class="text-sm text-text mb-3">{it.contenido.que_es}</p>
          )}

          {it.contenido?.por_que_importa && (
            <div class="mb-3">
              <h4 class="font-sans text-xs uppercase tracking-wider text-muted mb-1">Por que importa</h4>
              <p class="text-sm text-text">{it.contenido.por_que_importa}</p>
            </div>
          )}

          {it.contenido?.madurez_senales && (
            <p class="text-xs text-muted mb-3">{it.contenido.madurez_senales}</p>
          )}

          {it.relacion_grafo && it.relacion_grafo.length > 0 && (
            <div class="mb-3">
              <h4 class="font-sans text-xs uppercase tracking-wider text-muted mb-1">Relacion con el grafo</h4>
              <ul class="text-xs font-mono text-muted space-y-1">
                {it.relacion_grafo.map((t: any) => (
                  <li>
                    {t.src} <span class="text-[var(--color-accent)]">--[{t.rel}]--&gt;</span> {t.dst}
                    {t.primera_mencion && <span class="text-text not-italic font-sans"> (ya cubierto el {t.primera_mencion})</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {it.contenido?.accion_sugerida && (
            <span class={`inline-block text-xs px-2 py-0.5 rounded font-semibold ${accionColor(it.contenido.accion_sugerida)}`}>
              {it.contenido.accion_sugerida}
            </span>
          )}
        </article>
      ))}
    </div>
  </section>

  {radar.length > 0 && (
    <section class="mb-12">
      <h2 class="font-sans text-sm uppercase tracking-wider text-muted mb-4">Radar secundario</h2>
      <div class="space-y-3">
        {radar.map((it) => (
          <article class="border border-[var(--color-border)] rounded p-4 bg-[var(--color-surface)] text-sm">
            <div class="flex items-center justify-between gap-3 mb-1 flex-wrap">
              <a href={it.url} target="_blank" rel="noopener" class="font-mono">{it.titulo}</a>
              {it.contenido?.accion_sugerida && (
                <span class={`text-xs px-2 py-0.5 rounded font-semibold ${accionColor(it.contenido.accion_sugerida)}`}>
                  {it.contenido.accion_sugerida}
                </span>
              )}
            </div>
            {it.contenido?.que_es && <p class="text-text">{it.contenido.que_es}</p>}
            {it.contenido?.madurez_senales && <p class="text-xs text-muted mt-1">{it.contenido.madurez_senales}</p>}
          </article>
        ))}
      </div>
    </section>
  )}

  {edges.length > 0 && (
    <details class="mb-12 border border-[var(--color-border)] rounded-lg p-5 bg-[var(--color-surface)]">
      <summary class="font-sans text-sm uppercase tracking-wider text-muted cursor-pointer">
        Edges del grafo ({edges.length})
      </summary>
      <div class="space-y-1 mt-4">
        {edges.slice(0, 60).map((e) => (
          <div class="font-mono text-xs text-muted">
            {e.src} <span class="text-[var(--color-accent)]">--[{e.rel}]--&gt;</span> {e.dst}
            {e.primera_mencion && <span> (ya cubierto el {e.primera_mencion})</span>}
          </div>
        ))}
        {edges.length > 60 && <p class="text-xs text-muted mt-3">…y {edges.length - 60} edges mas</p>}
      </div>
    </details>
  )}

  <footer class="mt-16 pt-6 border-t border-[var(--color-border)] text-xs text-muted">
    <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}enriquecido/`}>&larr; Volver al &iacute;ndice</a>
    {enriched?.boletin_origen && <span class="ml-3">&middot; Fuente: {enriched.boletin_origen}</span>}
  </footer>
</BaseLayout>
