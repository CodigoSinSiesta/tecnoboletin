---
/**
 * Portada: manda directamente al boletín del día (la visita del 90% de las
 * mañanas) y deja el resto — archivo, triaje, grafo — como accesos con
 * contexto, no como una lista plana de fechas repetidas.
 */
import { readdir } from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { mdInline } from '../lib/markdown';
import { fmtDateLong, listDates, loadBoletin, titularYEntradilla } from '../lib/boletin';
import { linkCount, nodeCount } from '../lib/graph';

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');

const dates = await listDates();
const hoy = dates[0] ?? null;
const boletin = hoy ? await loadBoletin(hoy) : null;
const { titular } = titularYEntradilla(boletin?.editorial ?? null);

const boloDir = path.join(process.cwd(), 'src', 'content', 'boletines');
const markdownBoletines = (await readdir(boloDir).catch(() => [] as string[]))
  .filter((f) => f.endsWith('.md'))
  .map((f) => f.replace(/\.md$/, ''))
  .filter((s) => /^\d{4}-\d{2}-\d{2}/.test(s));
---
<BaseLayout title="Inicio" activeNav="inicio">
  <section class="mb-14">
    <p class="eyebrow mb-4">Boletín diario · Código Sin Siesta</p>
    <h1 class="font-display font-extrabold leading-[0.95] mb-5" style="font-size: clamp(2.5rem, 6vw, 4rem);">
      Tecnoboletín
    </h1>
    <p class="prose-card text-body text-lg">
      Cada mañana, las tendencias de repositorios y sus conexiones con todo lo ya cubierto:
      boletín enriquecido, consola de triaje y un grafo de conocimiento que crece día a día.
      Sin trackers, sin nube forzada.
    </p>
  </section>

  {hoy && boletin && (
    <section class="mb-12">
      <a
        href={`${base}hoy/`}
        class="block border border-border-strong rounded-2xl overflow-hidden bg-bg-raised hover:border-accent transition-colors"
      >
        <div class="brand-rule"></div>
        <div class="hero-glow px-6 md:px-8 py-7">
          <p class="eyebrow mb-3">Último boletín · {fmtDateLong(hoy)}</p>
          {titular ? (
            <h2 class="font-display font-extrabold text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.08] text-text max-w-[780px] mb-4" set:html={mdInline(titular)} />
          ) : (
            <h2 class="font-display font-extrabold text-3xl text-text mb-4">Boletín {hoy}</h2>
          )}
          <div class="flex flex-wrap gap-x-6 gap-y-2 items-center font-mono text-xs text-muted-dim">
            <span><span class="text-text text-[15px] font-semibold">{boletin.hallazgos.length}</span> hallazgos</span>
            <span class="text-border-strong">·</span>
            <span><span class="text-text text-[15px] font-semibold">{boletin.radar.length}</span> radar</span>
            {boletin.pickIdx.size > 0 && (
              <>
                <span class="text-border-strong">·</span>
                <span><span class="text-accent text-[15px] font-semibold">{boletin.pickIdx.size}</span> picks editoriales</span>
              </>
            )}
            <span class="ml-auto font-mono text-[0.688rem] text-accent-soft">Leer el boletín →</span>
          </div>
        </div>
      </a>
    </section>
  )}

  <section class="mb-14 grid md:grid-cols-3 gap-4">
    <a href={`${base}enriquecido/`} class="card card--rail p-5" style="--rail: var(--color-accent);">
      <h3 class="font-display text-lg font-bold text-text mb-1.5">Archivo</h3>
      <p class="text-muted text-sm leading-[1.5]">
        {dates.length} boletines enriquecidos, con el reparto de acciones de cada día a la vista.
      </p>
    </a>
    {hoy && (
      <a href={`${base}triaje/${hoy}/`} class="card card--rail p-5" style="--rail: var(--color-go);">
        <h3 class="font-display text-lg font-bold text-text mb-1.5">Triaje</h3>
        <p class="text-muted text-sm leading-[1.5]">
          El boletín como bandeja de decisiones: explorar, probar, leer o vigilar, con atajos de teclado.
        </p>
      </a>
    )}
    <a href={`${base}grafo/`} class="card card--rail p-5" style="--rail: var(--color-accent-soft);">
      <h3 class="font-display text-lg font-bold text-text mb-1.5">Grafo</h3>
      <p class="text-muted text-sm leading-[1.5]">
        {nodeCount} nodos y {linkCount} relaciones: cómo se conecta todo lo que han cruzado los boletines.
      </p>
    </a>
  </section>

  {markdownBoletines.length > 0 && (
    <section class="mb-14">
      <div class="section-rule" style="--rule-color: var(--color-border-strong);">
        <span class="section-rule__label text-muted">Sin enriquecer ({markdownBoletines.length})</span>
      </div>
      <p class="text-muted-dim text-xs mb-4">
        Boletines sincronizados desde el vault que aún no han pasado por el enriquecedor.
      </p>
      <ul class="text-sm space-y-2">
        {markdownBoletines.map((slug) => (
          <li>
            <a href={`${base}boletines/${slug}/`} class="text-muted hover:text-text font-mono">{slug}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
