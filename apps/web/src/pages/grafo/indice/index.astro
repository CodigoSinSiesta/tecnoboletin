---
/**
 * Índice de texto del grafo: los mismos nodos que el explorador 3D, en
 * formato buscable y enlazable (#id-de-nodo). Es también el destino de los
 * chips de grafo del boletín, que enlazan aquí por ancla.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fmtNum } from '../../../lib/boletin';
import {
  linkCount, links, nodeCount, nodes, REL_LABEL, TYPE_LABEL, colorForType,
  type GraphLink, type GraphNode,
} from '../../../lib/graph';

const byId = new Map(nodes.map((n) => [n.id, n]));
const relsByNode = new Map<string, { rel: string; dir: 'out' | 'in'; other: GraphNode; added?: string; note?: string }[]>();
for (const l of links as GraphLink[]) {
  const src = byId.get(l.source);
  const dst = byId.get(l.target);
  if (!src || !dst) continue;
  if (!relsByNode.has(src.id)) relsByNode.set(src.id, []);
  if (!relsByNode.has(dst.id)) relsByNode.set(dst.id, []);
  relsByNode.get(src.id)!.push({ rel: l.rel, dir: 'out', other: dst, added: l.added, note: l.note });
  relsByNode.get(dst.id)!.push({ rel: l.rel, dir: 'in', other: src, added: l.added, note: l.note });
}

const sortedNodes = [...nodes].sort((a, b) => (b.degree ?? 0) - (a.degree ?? 0) || a.name.localeCompare(b.name));

const SECCION_LABEL: Record<string, string> = {
  hallazgo_principal: 'hallazgo principal',
  radar_secundario: 'radar secundario',
};

const baseUrl = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
---
<BaseLayout
  title="Índice del grafo de conocimiento"
  description="Todos los nodos y relaciones del grafo de conocimiento de Tecnoboletín, en formato buscable de texto."
  activeNav="grafo"
  width="wide"
  crumbs={['grafo', 'índice']}
>
  <div class="mb-6">
    <p class="eyebrow mb-3">Índice del grafo</p>
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-text mb-2">Todos los nodos</h1>
    <p class="text-muted max-w-2xl">
      {nodeCount} nodos y {linkCount} relaciones ordenados por conexiones.
      <a href={`${baseUrl}grafo/`} class="text-accent-soft hover:underline">Ver como grafo en 3D →</a>
    </p>
  </div>

  <input
    id="node-search"
    type="search"
    placeholder="Buscar por nombre, tipo o repositorio…"
    autocomplete="off"
    class="w-full mb-4 px-4 py-2.5 rounded-lg bg-surface border border-border-strong font-mono text-sm text-text placeholder:text-muted-dim focus:outline-none focus:border-accent-soft"
  />

  <p id="node-count" class="mono-meta mb-4"></p>

  <ul id="node-list" class="space-y-2">
    {sortedNodes.map((n) => {
      const rels = relsByNode.get(n.id) ?? [];
      const repoSlug = n.type === 'repo' && /^[\w.-]+\/[\w.-]+$/.test(n.id.replace(/^repo:/, ''))
        ? n.id.replace(/^repo:/, '')
        : null;
      return (
        <li
          class="node-row card"
          id={n.id}
          data-name={`${n.name} ${n.id}`.toLowerCase()}
          data-type={n.type.toLowerCase()}
        >
          <details>
            <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between gap-3">
              <span class="flex items-center gap-2.5 min-w-0">
                <span class="dot w-2 h-2 shrink-0" style={`background:${colorForType(n.type)}`}></span>
                <span class="shrink-0 text-[0.625rem] uppercase tracking-wide font-mono text-muted-dim">
                  {TYPE_LABEL[n.type] ?? n.type}
                </span>
                <span class="font-mono text-sm text-text truncate">{n.name}</span>
                {n.synthetic && <span class="shrink-0 text-[0.625rem] text-muted-dim">(inferido)</span>}
              </span>
              <span class="shrink-0 mono-meta">{rels.length} rel.</span>
            </summary>
            <div class="px-4 pb-4 border-t border-border pt-3">
              <div class="flex gap-2 flex-wrap mb-2">
                {repoSlug && <a href={`${baseUrl}repo/${repoSlug}/`} class="pill pill--solid">Abrir ficha</a>}
                {repoSlug && (
                  <a href={`https://github.com/${repoSlug}`} target="_blank" rel="noopener" class="pill pill--ghost">GitHub ↗</a>
                )}
                <a href={`${baseUrl}grafo/#${encodeURIComponent(n.id)}`} class="pill pill--ghost">Ver en 3D</a>
                <button type="button" class="pill pill--ghost nodo-fav hidden" data-id={n.id}>☆ Guardar</button>
              </div>
              {n.resumen && (
                <p class="text-sm text-body mb-2 border-l-2 border-accent-deep pl-2.5">{n.resumen}…</p>
              )}
              {n.description && n.description !== n.resumen && (
                <p class="text-xs text-muted-dim mb-2">{n.description}</p>
              )}
              {n.stars != null && (
                <p class="mono-meta mb-2">★ {fmtNum(n.stars)}{n.lang ? ` · ${n.lang}` : ''}</p>
              )}
              {(n.apariciones?.length ?? 0) > 0 && (
                <div class="mb-2">
                  <div class="flow-label mb-1">Visto en boletines ({n.apariciones!.length})</div>
                  <div class="flex flex-wrap gap-1">
                    {n.apariciones!.map((a) => (
                      <a
                        href={`${baseUrl}enriquecido/${a.date}/`}
                        class="font-mono text-[0.65rem] px-1.5 py-0.5 rounded bg-bg-raised border border-border text-accent-soft hover:underline"
                        title={SECCION_LABEL[a.seccion ?? ''] ?? a.seccion}
                      >
                        {a.date} · {SECCION_LABEL[a.seccion ?? ''] ?? a.seccion}
                      </a>
                    ))}
                  </div>
                </div>
              )}
              {(n.menciones?.length ?? 0) > 0 && (
                <div class="mb-2">
                  <div class="flow-label mb-1">Mencionado en</div>
                  <div class="flex flex-wrap gap-1">
                    {n.menciones!.map((d) => (
                      <a
                        href={`${baseUrl}enriquecido/${d}/`}
                        class="font-mono text-[0.65rem] px-1.5 py-0.5 rounded bg-bg-raised border border-border text-muted hover:text-accent-soft"
                      >
                        {d}
                      </a>
                    ))}
                  </div>
                </div>
              )}
              {rels.length > 0 ? (
                <ul class="space-y-1 font-mono text-xs">
                  {rels.map((r) => (
                    <li class="text-muted">
                      {REL_LABEL[r.rel] ?? r.rel} {r.dir === 'out' ? '→' : '←'}{' '}
                      <span class="text-text">{r.other.name}</span>
                      {r.added && <span class="text-muted-dim"> · {r.added}</span>}
                      {r.note && <div class="text-muted-dim not-italic pl-4">— {r.note}</div>}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-xs text-muted-dim">Sin relaciones registradas.</p>
              )}
            </div>
          </details>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<script>
  import { getSupabase, getSessionResilient } from '../../../lib/supabase';

  const search = document.getElementById('node-search') as HTMLInputElement;
  const rows = Array.from(document.querySelectorAll<HTMLLIElement>('.node-row'));
  const countEl = document.getElementById('node-count')!;

  function applyFilter() {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const match = !q || row.dataset.name!.includes(q) || row.dataset.type!.includes(q);
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    }
    countEl.textContent = q ? `${visible} de ${rows.length} nodos` : `${rows.length} nodos`;
  }

  search.addEventListener('input', applyFilter);
  applyFilter();

  // Llegada por ancla (#repo:owner/name desde los chips del boletín):
  // se abre el <details> del nodo y se lleva a la vista.
  const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
  if (hash) {
    const row = document.getElementById(hash);
    if (row) {
      row.querySelector('details')?.setAttribute('open', '');
      row.scrollIntoView({ block: 'center' });
    }
  }

  // Guardado de nodos con sesion iniciada (user_favorites, kind 'nodo').
  // Una sola consulta trae todo lo guardado y pinta los 800+ botones.
  (async () => {
    const supabase = getSupabase();
    const session = await getSessionResilient();
    if (!session) return;
    const { data } = await supabase.from('user_favorites').select('ref').eq('kind', 'nodo');
    const savedSet = new Set((data ?? []).map((r: { ref: string }) => r.ref));
    document.querySelectorAll<HTMLButtonElement>('.nodo-fav').forEach((btn) => {
      const ref = btn.dataset.id!;
      let on = savedSet.has(ref);
      const paint = () => { btn.textContent = on ? '★ Guardado' : '☆ Guardar'; };
      paint();
      btn.classList.remove('hidden');
      btn.addEventListener('click', async () => {
        if (on) await supabase.from('user_favorites').delete().eq('kind', 'nodo').eq('ref', ref);
        else await supabase.from('user_favorites').insert({ kind: 'nodo', ref, user_id: session.user.id });
        on = !on;
        paint();
      });
    });
  })();
</script>
