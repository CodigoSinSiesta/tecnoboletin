---
/**
 * Explorador del grafo de conocimiento.
 *
 * Antes era un lienzo 3D a pantalla completa con un panel flotante que
 * tapaba el propio grafo. Ahora es una consola de tres columnas —
 * filtros / lienzo / inspector — y el inspector incluye la barra temporal
 * "cómo creció este nodo", que es lo que convierte el grafo en algo que
 * se lee junto al boletín y no aparte de él.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listDates } from '../../lib/boletin';
import { generatedAt, linkCount, nodeCount, relCounts, TYPE_COLOR, TYPE_LABEL, typeCounts } from '../../lib/graph';

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
const dates = await listDates();
const desde = dates[dates.length - 1] ?? '';
const hasta = dates[0] ?? '';

const legend = Object.entries(typeCounts).sort((a, b) => b[1] - a[1]);
const rels = Object.entries(relCounts).sort((a, b) => b[1] - a[1]).slice(0, 8);
---
<BaseLayout
  title="Grafo de conocimiento"
  description="Cómo se relacionan entre sí los repos, conceptos y herramientas que ha ido cruzando Tecnoboletín, en 3D."
  activeNav="grafo"
  width="full"
  crumbs={['grafo']}
>
  <div class="border-b border-border">
    <div class="h-12 px-4 md:px-6 flex items-center gap-3 border-b border-border bg-bg-raised">
      <h1 class="crumb crumb__here">Grafo de conocimiento</h1>
      <span class="ml-auto mono-meta hidden sm:inline">
        {nodeCount} nodos · {linkCount} relaciones{generatedAt && ` · act. ${generatedAt}`}
      </span>
      <a href={`${base}grafo/indice/`} class="pill pill--ghost">Índice de texto</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[210px_1fr_300px] min-h-[560px] lg:h-[calc(100vh-190px)]">
      <!-- ── Filtros ── -->
      <div class="border-b lg:border-b-0 lg:border-r border-border bg-rail p-4 flex flex-col gap-4 scroll-y">
        <div>
          <div class="flow-label mb-2">Buscar</div>
          <div class="relative">
            <input
              id="graph-search"
              type="search"
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-autocomplete="list"
              aria-controls="graph-suggest"
              placeholder="claude-code…"
              class="w-full border border-border-strong rounded-lg bg-surface px-2.5 py-1.5 font-mono text-xs text-text placeholder:text-muted-dim focus:outline-none focus:border-accent-soft"
            />
            <ul id="graph-suggest" class="graph-suggest hidden" role="listbox" aria-label="Sugerencias"></ul>
          </div>
        </div>

        <div>
          <div class="flow-label mb-2">Tipos</div>
          <div class="flex flex-col gap-1.5" id="graph-legend">
            {legend.map(([type, count]) => (
              <button
                type="button"
                data-type={type}
                data-active="true"
                class="graph-legend-pill flex items-center gap-2 font-mono text-[0.719rem] text-text hover:text-accent-dim transition-colors"
              >
                <span class="dot w-2 h-2 node-dot" data-type={type} style={`background:${TYPE_COLOR[type] ?? '#475569'}`}></span>
                <span class="truncate">{TYPE_LABEL[type] ?? type}</span>
                <span class="ml-auto text-muted-dim">{count}</span>
              </button>
            ))}
          </div>
        </div>

        <div>
          <div class="flow-label mb-2">Relación</div>
          <div class="flex flex-wrap gap-1.5" id="graph-rels">
            {rels.map(([rel, count]) => (
              <button
                type="button"
                data-rel={rel}
                data-active="true"
                class="graph-rel-pill font-mono text-[0.656rem] px-2 py-0.5 rounded-full bg-bg-raised border border-border text-body hover:border-accent-soft transition-colors"
              >
                {rel} <span class="text-muted-dim">{count}</span>
              </button>
            ))}
          </div>
        </div>

        <p class="mt-auto text-[0.719rem] leading-[1.5] text-muted-dim">
          Los nodos «inferidos» solo existen como extremo de una relación: su tipo y su nombre se derivan del
          identificador, no son un dato verificado.
        </p>
      </div>

      <!-- ── Lienzo ── -->
      <div class="relative graph-glow overflow-hidden min-h-[420px]" id="graph-shell">
        <div id="graph-loading" class="absolute inset-0 flex items-center justify-center mono-meta">cargando grafo…</div>
        <div
          id="graph-foco-aviso"
          class="hidden absolute left-1/2 -translate-x-1/2 top-4 z-10 flex items-center gap-2 px-3 py-1.5 rounded-full bg-bg-raised/92 border border-border-strong backdrop-blur mono-meta"
        >
          <span class="csi-dot" aria-hidden="true"></span>
          <span>situando el nodo…</span>
        </div>
        <div id="graph-container" class="w-full h-full"></div>
        <div class="absolute left-4 bottom-4 flex gap-1.5">
          <button type="button" id="graph-zoom-out" class="font-mono text-[0.656rem] px-2.5 py-1.5 rounded-lg bg-bg-raised/90 border border-border-strong text-muted hover:text-text">−</button>
          <button type="button" id="graph-zoom-in" class="font-mono text-[0.656rem] px-2.5 py-1.5 rounded-lg bg-bg-raised/90 border border-border-strong text-muted hover:text-text">+</button>
          <button type="button" id="graph-recenter" class="font-mono text-[0.656rem] px-2.5 py-1.5 rounded-lg bg-bg-raised/90 border border-border-strong text-muted hover:text-text">reencuadrar</button>
        </div>
      </div>

      <!-- ── Inspector ── -->
      <aside
        class="border-t lg:border-t-0 lg:border-l border-border bg-rail flex flex-col min-w-0"
        id="graph-panel"
        data-base={base}
        data-desde={desde}
        data-hasta={hasta}
      >
        <div id="graph-panel-empty" class="flex-1 flex items-center justify-center p-6 text-center mono-meta">
          Clic en un nodo para ver su ficha,<br />o busca uno por nombre.
        </div>
        <div id="graph-panel-body" class="hidden flex-1 flex-col min-h-0"></div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  #graph-container :global(canvas) { display: block; }
</style>

<script>
  /**
   * Explorador 3D: filtros, inspector y barra temporal.
   *
   * El grafo se descarga en runtime desde /data/knowledge-graph.json (300 KB)
   * en vez de empaquetarse: la página pinta su chrome al instante y el
   * lienzo se rellena cuando llegan los datos. Del módulo compartido solo
   * se importan constantes.
   */
  import { colorForType, REL_LABEL, TYPE_LABEL } from '../../lib/graph-tokens';
  import { getSupabase, getSessionResilient } from '../../lib/supabase';

  interface GNode {
    id: string; name: string; type: string; degree?: number;
    resumen?: string; description?: string; stars?: number; lang?: string; synthetic?: boolean;
    apariciones?: { date: string; seccion?: string }[]; menciones?: string[];
    x?: number; y?: number; z?: number;
  }
  interface GLink { source: string | GNode; target: string | GNode; rel: string }
  interface Neighbor { rel: string; dir: 'out' | 'in'; other: GNode; otherId: string }

  const panel = document.getElementById('graph-panel')!;
  const panelBody = document.getElementById('graph-panel-body')!;
  const panelEmpty = document.getElementById('graph-panel-empty')!;
  const search = document.getElementById('graph-search') as HTMLInputElement;
  const avisoFoco = document.getElementById('graph-foco-aviso');
  const base = panel.dataset.base ?? '/';
  const desde = panel.dataset.desde ?? '';
  const hasta = panel.dataset.hasta ?? '';

  // Guardado de nodos (user_favorites, kind 'nodo') — el boton del
  // inspector solo aparece con sesion iniciada; /cuenta/ lista lo guardado.
  const supabase = getSupabase();
  let favUserId: string | null = null;
  const favReady = getSessionResilient().then((session) => {
    favUserId = session?.user.id ?? null;
  });

  async function wireFav(ref: string) {
    const btn = document.getElementById('graph-panel-fav') as HTMLButtonElement | null;
    if (!btn) return;
    await favReady;
    if (!favUserId) return;
    const { data } = await supabase
      .from('user_favorites').select('id').eq('kind', 'nodo').eq('ref', ref).maybeSingle();
    let saved = !!data;
    const paint = () => { btn.textContent = saved ? '★ Guardado' : '☆ Guardar'; };
    paint();
    btn.classList.remove('hidden');
    btn.onclick = async () => {
      if (saved) await supabase.from('user_favorites').delete().eq('kind', 'nodo').eq('ref', ref);
      else await supabase.from('user_favorites').insert({ kind: 'nodo', ref, user_id: favUserId });
      saved = !saved;
      paint();
    };
  }

  // Tipos y relaciones activos: se inicializan con TODO encendido a partir
  // de las pills que ya renderizó el servidor, así los filtros funcionan
  // (visualmente) antes incluso de que lleguen los datos.
  const activeTypes = new Set(
    Array.from(document.querySelectorAll<HTMLElement>('.graph-legend-pill')).map((p) => p.dataset.type!)
  );
  const filtrables = new Set(
    Array.from(document.querySelectorAll<HTMLElement>('.graph-rel-pill')).map((p) => p.dataset.rel!)
  );
  const activeRels = new Set(filtrables);

  let Graph: any = null;
  // Nodo seleccionado: se pinta con un anillo ámbar para saber en todo
  // momento cuál es el que está abierto en el inspector.
  let selectedId: string | null = null;
  // Nodo que espera a que la simulación se asiente para ser enfocado.
  let focoPendiente: GNode | null = null;
  let byId = new Map<string, GNode>();
  let allNodes: GNode[] = [];
  let neighborIndex = new Map<string, Neighbor[]>();

  function escapeHtml(s: unknown) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function neighbors(id: string): Neighbor[] {
    return neighborIndex.get(id) ?? [];
  }

  /** Fechas en las que el nodo apareció o fue mencionado, ordenadas. */
  function timeline(n: GNode): string[] {
    const dates = new Set<string>();
    for (const a of n.apariciones ?? []) if (a.date) dates.add(a.date);
    for (const d of n.menciones ?? []) if (d) dates.add(d);
    return [...dates].sort();
  }

  /** Barra "cómo creció este nodo": una marca por boletín en el que apareció. */
  function scrubber(n: GNode) {
    const marks = timeline(n);
    if (!marks.length || !desde || !hasta) return '';
    const t0 = Date.parse(desde);
    const span = Math.max(Date.parse(hasta) - t0, 1);
    const pct = (d: string) => Math.min(100, Math.max(0, ((Date.parse(d) - t0) / span) * 100));
    const last = marks[marks.length - 1];
    const ticks = marks
      .map((d, i) => {
        const cls =
          i === marks.length - 1 ? 'scrub__tick scrub__tick--last'
          : i === 0 ? 'scrub__tick scrub__tick--first'
          : 'scrub__tick';
        return `<span class="${cls}" style="left:${pct(d).toFixed(2)}%" title="${escapeHtml(d)}"></span>`;
      })
      .join('');
    return `
      <div class="px-4 py-3 border-t border-border">
        <div class="flex items-center justify-between mb-2">
          <span class="flow-label">Cómo creció este nodo</span>
          <span class="font-mono text-[0.656rem] text-muted">${escapeHtml(desde)} → ${escapeHtml(hasta)}</span>
        </div>
        <div class="scrub">
          <div class="scrub__track"></div>
          <div class="scrub__fill" style="width:${pct(last).toFixed(2)}%"></div>
          ${ticks}
          <span class="scrub__label" style="left:${pct(last).toFixed(2)}%">${escapeHtml(last)} · ${marks.length}</span>
        </div>
      </div>`;
  }

  function showPanel(n: GNode) {
    if (selectedId !== n.id) {
      selectedId = n.id;
      Graph?.nodeThreeObject(nodeObject).nodeColor(nodeColor);
    }
    const rels = neighbors(n.id);
    const apariciones = n.apariciones ?? [];
    const menciones = n.menciones ?? [];
    const slug = n.type === 'repo' && /^[\w.-]+\/[\w.-]+$/.test(n.id.replace(/^repo:/, ''))
      ? n.id.replace(/^repo:/, '')
      : null;

    panelBody.innerHTML = `
      <div class="px-4 pt-4 pb-3 border-b border-border">
        <div class="flex items-start justify-between gap-2">
          <span class="font-mono text-[0.938rem] text-text font-semibold break-all">${escapeHtml(n.name)}</span>
          <button type="button" id="graph-panel-close" class="text-muted-dim hover:text-text shrink-0" aria-label="Cerrar">✕</button>
        </div>
        <div class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-muted-dim mt-1.5">
          ${escapeHtml(TYPE_LABEL[n.type] ?? n.type)}${n.synthetic ? ' · inferido' : ''}${n.stars != null ? ` · ★ ${escapeHtml(n.stars)}` : ''}${n.lang ? ` · ${escapeHtml(n.lang)}` : ''}
        </div>
      </div>
      <div class="scroll-y flex-1 px-4 py-4 flex flex-col gap-4">
        <div class="flex gap-2 flex-wrap">${slug ? `<a href="${base}repo/${escapeHtml(slug)}/" class="pill pill--solid">Abrir ficha</a>` : ''}<button type="button" id="graph-panel-fav" class="pill pill--ghost hidden">☆ Guardar</button></div>
        ${n.resumen ? `<p class="prose-card text-[0.813rem] text-body border-l-2 border-accent-deep pl-3">${escapeHtml(n.resumen)}…</p>` : ''}
        ${n.description && n.description !== n.resumen ? `<p class="text-xs text-muted-dim">${escapeHtml(n.description)}</p>` : ''}
        ${apariciones.length ? `
          <div>
            <div class="flow-label mb-1.5">Visto en boletines · ${apariciones.length}</div>
            <div class="flex flex-wrap gap-1.5">
              ${apariciones.slice(0, 10).map((a) =>
                `<a href="${base}enriquecido/${escapeHtml(a.date)}/" class="font-mono text-[0.656rem] px-2 py-0.5 rounded bg-bg-raised border border-border text-accent-soft">${escapeHtml(a.date)}</a>`
              ).join('')}
              ${apariciones.length > 10 ? `<span class="mono-meta">+${apariciones.length - 10}</span>` : ''}
            </div>
          </div>` : ''}
        ${menciones.length ? `
          <div>
            <div class="flow-label mb-1.5">Mencionado en</div>
            <div class="flex flex-wrap gap-1.5">
              ${menciones.slice(0, 10).map((d) =>
                `<a href="${base}enriquecido/${escapeHtml(d)}/" class="font-mono text-[0.656rem] px-2 py-0.5 rounded bg-bg-raised border border-border text-muted">${escapeHtml(d)}</a>`
              ).join('')}
              ${menciones.length > 10 ? `<span class="mono-meta">+${menciones.length - 10}</span>` : ''}
            </div>
          </div>` : ''}
        <div>
          <div class="flow-label mb-1.5">Relaciones · ${rels.length}</div>
          <ul class="flex flex-col gap-1.5 font-mono text-[0.688rem]">
            ${rels.slice(0, 40).map((r) =>
              `<li class="text-muted">${escapeHtml(REL_LABEL[r.rel] ?? r.rel)} ${r.dir === 'out' ? '→' : '←'} <button type="button" class="text-text hover:text-accent-soft graph-jump" data-id="${escapeHtml(r.otherId)}">${escapeHtml(r.other.name)}</button></li>`
            ).join('')}
            ${rels.length > 40 ? `<li class="mono-meta">+${rels.length - 40} más</li>` : ''}
          </ul>
        </div>
      </div>
      ${scrubber(n)}
    `;
    panelBody.classList.remove('hidden');
    panelBody.classList.add('flex');
    panelEmpty.classList.add('hidden');

    document.getElementById('graph-panel-close')?.addEventListener('click', hidePanel);
    panelBody.querySelectorAll<HTMLElement>('.graph-jump').forEach((b) => {
      const target = byId.get(b.dataset.id!);
      if (target) b.addEventListener('click', () => focusNode(target));
    });
    wireFav(n.id);
  }

  function hidePanel() {
    panelBody.classList.add('hidden');
    panelBody.classList.remove('flex');
    panelEmpty.classList.remove('hidden');
    if (selectedId) {
      selectedId = null;
      Graph?.nodeThreeObject(nodeObject).nodeColor(nodeColor);
    }
  }

  /**
   * Anillo ámbar del nodo seleccionado.
   *
   * Se usa un sprite con textura de canvas en lugar de geometría 3D: el
   * sprite mira siempre a la cámara, así que el anillo se ve como un
   * círculo desde cualquier ángulo, y cuesta un draw call.
   */
  let ringTexture: any = null;
  async function getRingTexture() {
    if (ringTexture) return ringTexture;
    const THREE = await import('three');
    const size = 128;
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const ctx = c.getContext('2d')!;
    ctx.strokeStyle = '#FBBF24'; // --color-warn
    ctx.lineWidth = 9;
    ctx.beginPath();
    ctx.arc(size / 2, size / 2, size / 2 - 10, 0, Math.PI * 2);
    ctx.stroke();
    ringTexture = new THREE.CanvasTexture(c);
    return ringTexture;
  }

  // Se precarga para que el primer clic no espere al import dinámico.
  let THREEMod: any = null;
  import('three').then((m) => { THREEMod = m; getRingTexture(); });

  function nodeObject(n: GNode) {
    if (n.id !== selectedId || !THREEMod || !ringTexture) return null;
    const radio = 4 + Math.sqrt(1 + Math.min(n.degree ?? 1, 20) * 0.6) * 4;
    const sprite = new THREEMod.Sprite(
      new THREEMod.SpriteMaterial({ map: ringTexture, transparent: true, depthWrite: false })
    );
    sprite.scale.set(radio, radio, 1);
    return sprite;
  }

  function nodeColor(n: GNode) {
    if (n.id === selectedId) return '#FBBF24';
    return activeTypes.has(n.type) ? colorForType(n.type) : 'rgba(148,163,184,0.08)';
  }

  /**
   * Lleva la vista a un nodo.
   *
   * Encuadra el nodo Y SUS RELACIONES DIRECTAS en vez de acercarse a una
   * distancia fija: con distancia fija el resultado dependía de la escala
   * del grafo y acababa en primer plano, con los nodos llenando la
   * pantalla. Llegando desde un artículo lo que se quiere ver es el nodo
   * en su contexto.
   */
  function focusNode(n: GNode) {
    showPanel(n);
    if (!Graph) return;

    const vecindario = new Set<string>([n.id, ...neighbors(n.id).map((r) => r.otherId)]);
    if (vecindario.size > 1) {
      Graph.zoomToFit(900, 70, (nd: GNode) => vecindario.has(nd.id));
      return;
    }

    // Nodo aislado: no hay caja que encuadrar (zoomToFit sobre un punto
    // se dispara), así que se coloca la cámara a una distancia fija.
    const nx = n.x ?? 0, ny = n.y ?? 0, nz = n.z ?? 0;
    const ratio = 1 + 260 / Math.hypot(nx, ny, nz, 1);
    Graph.cameraPosition({ x: nx * ratio, y: ny * ratio, z: nz * ratio }, { x: nx, y: ny, z: nz }, 900);
  }

  async function init() {
    const res = await fetch(`${base}data/knowledge-graph.json`);
    const data = (await res.json()) as { nodes: GNode[]; links: GLink[] };

    allNodes = data.nodes;
    byId = new Map(allNodes.map((n) => [n.id, n]));
    neighborIndex = new Map();
    for (const l of data.links) {
      const s = typeof l.source === 'object' ? l.source.id : l.source;
      const t = typeof l.target === 'object' ? l.target.id : l.target;
      const push = (from: string, to: string, dir: 'out' | 'in') => {
        const other = byId.get(to);
        if (!other) return;
        if (!neighborIndex.has(from)) neighborIndex.set(from, []);
        neighborIndex.get(from)!.push({ rel: l.rel, dir, other, otherId: to });
      };
      push(s, t, 'out');
      push(t, s, 'in');
    }

    const { default: ForceGraph3D } = await import('3d-force-graph');
    // Los tipos publicados de 3d-force-graph declaran el factory como si
    // necesitara `new`, pero en runtime es una funcion de doble-llamada
    // (ForceGraph3D()(el)) -- ver docs del paquete. Se castea a any solo
    // en el punto de instanciacion para no perder el resto del tipado.
    const makeGraph = ForceGraph3D as unknown as () => any;

    const container = document.getElementById('graph-container')!;
    const shell = document.getElementById('graph-shell')!;

    Graph = makeGraph()(container)
      .backgroundColor('#0B1220')
      .graphData(data)
      .nodeId('id')
      .nodeLabel((n: GNode) => `${n.name}${n.synthetic ? ' (inferido)' : ''}`)
      .nodeColor(nodeColor)
      .nodeThreeObject(nodeObject)
      .nodeThreeObjectExtend(true)
      .nodeVal((n: GNode) => 1 + Math.min(n.degree ?? 1, 20) * 0.6)
      .nodeOpacity(0.92)
      .linkColor(() => 'rgba(148,163,184,0.28)')
      .linkWidth(0.4)
      .linkVisibility((l: GLink) => !filtrables.has(l.rel) || activeRels.has(l.rel))
      .linkDirectionalParticles(0)
      .onNodeClick((n: GNode) => showPanel(n))
      .onBackgroundClick(hidePanel)
      .onEngineStop(() => {
        // La simulación ha parado: ahora las posiciones son definitivas y
        // enfocar tiene sentido. Antes de esto, apuntar a un nodo era
        // apuntar a donde estaba en el tick 0.
        if (focoPendiente) resolverFoco();
      });

    document.getElementById('graph-loading')?.remove();

    const zoom = (factor: number) => {
      const p = Graph.cameraPosition();
      Graph.cameraPosition({ x: p.x * factor, y: p.y * factor, z: p.z * factor }, undefined, 400);
    };
    document.getElementById('graph-zoom-in')?.addEventListener('click', () => zoom(0.75));
    document.getElementById('graph-zoom-out')?.addEventListener('click', () => zoom(1.35));
    document.getElementById('graph-recenter')?.addEventListener('click', () => Graph.zoomToFit(600, 40));

    const resize = () => Graph.width(shell.clientWidth).height(shell.clientHeight);
    window.addEventListener('resize', resize);
    resize();

    // Enlace directo desde el boletín o la ficha: /grafo/#repo:owner/name
    //
    // No se enfoca aquí: la simulación acaba de arrancar y las posiciones
    // cambian durante segundos, así que la cámara aterrizaría donde el
    // nodo estaba, no donde acaba. Se abre el inspector de inmediato (con
    // su anillo ámbar, para que se vea cuál es) y la cámara espera a
    // onEngineStop.
    const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
    const target = hash ? byId.get(hash) : undefined;
    if (target) {
      showPanel(target);
      focoPendiente = target;
      avisoFoco?.classList.remove('hidden');
      // Red de seguridad: si onEngineStop no llegara (grafo enorme, pestaña
      // en segundo plano), se enfoca igualmente pasados 8 s.
      setTimeout(() => { if (focoPendiente) resolverFoco(); }, 8000);
    }
  }

  /** Enfoca el nodo que estaba esperando y retira el aviso. */
  function resolverFoco() {
    const n = focoPendiente;
    focoPendiente = null;
    avisoFoco?.classList.add('hidden');
    if (n) focusNode(n);
  }

  // Búsqueda: matchea contra nombre e id y, entre los candidatos, prefiere
  // el más conectado — "claude-code" debe llevar a anthropics/claude-code,
  // no a un fork con dos relaciones.
  /**
   * Autocompletado.
   *
   * Antes cada tecla saltaba al nodo más conectado que coincidiera: para
   * usarlo había que saber de antemano qué existe en el grafo. Ahora se
   * ofrece una lista de candidatos (nombre, tipo y nº de relaciones) y no
   * se mueve la cámara hasta que se elige uno.
   */
  const suggestBox = document.getElementById('graph-suggest')!;
  let sugerencias: GNode[] = [];
  let activa = -1;

  function cerrarSugerencias() {
    suggestBox.classList.add('hidden');
    search.setAttribute('aria-expanded', 'false');
    sugerencias = [];
    activa = -1;
  }

  function pintarActiva() {
    suggestBox.querySelectorAll<HTMLElement>('li').forEach((li, i) => {
      li.dataset.activa = String(i === activa);
      if (i === activa) li.scrollIntoView({ block: 'nearest' });
    });
  }

  /**
   * Relevancia de un nodo para el texto buscado. Menor es mejor.
   *
   * El criterio decisivo es que la coincidencia caiga en el ARRANQUE DE UN
   * SEGMENTO, no solo al principio de la cadena: buscando "claude", lo que
   * se espera arriba es anthropics/claude-code (grado 10), y ordenar por
   * "empieza por" lo dejaba debajo de claude-world/... (grado 3) porque su
   * nombre empieza por "anthropics/".
   */
  function escapeRe(t: string): string {
    return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  /**
   * Relevancia de un nodo para el texto buscado. Menor es mejor.
   *
   * La clave es que empezar la cadena y empezar un SEGMENTO valen igual.
   * Con niveles distintos, buscar "claude" ponia claude-world/... (grado 3)
   * por encima de anthropics/claude-code (grado 10), porque el segundo
   * empieza por "anthropics/" — y el que uno espera arriba es el segundo.
   * Igualados, decide el numero de relaciones.
   */
  function rango(n: GNode, t: string): number {
    const nombre = n.name.toLowerCase();
    const id = n.id.toLowerCase();
    if (nombre === t || id === t) return 0;
    // Inicio de cadena o de segmento (tras / - _ . : o espacio). El guion
    // va el primero dentro de la clase para que sea literal y no un rango.
    const inicio = new RegExp('(^|[-/_.: ])' + escapeRe(t));
    if (inicio.test(nombre) || inicio.test(id)) return 1;
    return 2;
  }

  function buscar(q: string): GNode[] {
    const t = q.toLowerCase();
    return allNodes
      .filter((n) => n.name.toLowerCase().includes(t) || n.id.toLowerCase().includes(t))
      .sort((a, b) => rango(a, t) - rango(b, t) || (b.degree ?? 0) - (a.degree ?? 0))
      .slice(0, 8);
  }

  function abrirSugerencias(q: string) {
    sugerencias = buscar(q);
    if (!sugerencias.length) {
      suggestBox.innerHTML = '<li class="graph-suggest__vacio">sin coincidencias</li>';
      suggestBox.classList.remove('hidden');
      search.setAttribute('aria-expanded', 'true');
      return;
    }
    suggestBox.innerHTML = sugerencias
      .map(
        (n, i) => `
        <li role="option" data-i="${i}" data-activa="false">
          <span class="dot w-1.5 h-1.5 shrink-0" style="background:${colorForType(n.type)}"></span>
          <span class="graph-suggest__nombre">${escapeHtml(n.name)}</span>
          <span class="graph-suggest__meta">${n.degree ?? 0}</span>
        </li>`
      )
      .join('');
    suggestBox.classList.remove('hidden');
    search.setAttribute('aria-expanded', 'true');
    activa = 0;
    pintarActiva();
  }

  function elegir(i: number) {
    const n = sugerencias[i];
    if (!n) return;
    search.value = n.name;
    cerrarSugerencias();
    focusNode(n);
  }

  search.addEventListener('input', () => {
    const q = search.value.trim();
    if (!q || !allNodes.length) return cerrarSugerencias();
    abrirSugerencias(q);
  });

  search.addEventListener('keydown', (ev: KeyboardEvent) => {
    if (!sugerencias.length) return;
    if (ev.key === 'ArrowDown') {
      ev.preventDefault();
      activa = (activa + 1) % sugerencias.length;
      pintarActiva();
    } else if (ev.key === 'ArrowUp') {
      ev.preventDefault();
      activa = (activa - 1 + sugerencias.length) % sugerencias.length;
      pintarActiva();
    } else if (ev.key === 'Enter') {
      ev.preventDefault();
      elegir(activa);
    } else if (ev.key === 'Escape') {
      cerrarSugerencias();
    }
  });

  suggestBox.addEventListener('mousedown', (ev: MouseEvent) => {
    // mousedown y no click: el blur del input cerraría la lista antes.
    const li = (ev.target as HTMLElement).closest('li[data-i]');
    if (!li) return;
    ev.preventDefault();
    elegir(Number((li as HTMLElement).dataset.i));
  });

  search.addEventListener('blur', () => setTimeout(cerrarSugerencias, 120));

  document.querySelectorAll<HTMLElement>('.graph-legend-pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      const type = pill.dataset.type!;
      const on = activeTypes.has(type);
      if (on) activeTypes.delete(type); else activeTypes.add(type);
      pill.dataset.active = String(!on);
      Graph?.refresh();
    });
  });

  document.querySelectorAll<HTMLElement>('.graph-rel-pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      const rel = pill.dataset.rel!;
      const on = activeRels.has(rel);
      if (on) activeRels.delete(rel); else activeRels.add(rel);
      pill.dataset.active = String(!on);
      pill.classList.toggle('opacity-40', on);
      Graph?.refresh();
    });
  });

  init();
</script>
