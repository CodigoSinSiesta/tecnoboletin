---
import '../styles/global.css';
import { listDates } from '../lib/boletin';

interface Props {
  title: string;
  description?: string;
  /** Clave de la sección activa en la nav, para resaltar la pill correcta.
   *  Se pasa explícitamente en vez de derivarla de Astro.url.pathname
   *  porque en build estático con `base: '/tecnoboletin'` esa comparación
   *  es fragil (barras finales, base incluida o no según la página). */
  activeNav?: 'hoy' | 'archivo' | 'triaje' | 'grafo' | 'temas' | 'fuentes' | 'cuenta' | 'inicio';
  /** Ancho del contenido:
   *  - `reading` (por defecto): columna de lectura, para páginas de texto.
   *  - `wide`: 1280px, el lienzo del boletín y de la ficha de repositorio.
   *  - `full`: sin caja ni padding — pantallas tipo consola (triaje, grafo)
   *    que gestionan su propio layout a sangre. */
  width?: 'reading' | 'wide' | 'full';
  /** Migas monoespaciadas del chrome, tras "tecnoboletín". */
  crumbs?: string[];
}

const {
  title,
  description = 'Lectura cómoda de los boletines de Código Sin Siesta',
  activeNav,
  width = 'reading',
  crumbs = [],
} = Astro.props;

// Base URL: en Astro 5, `import.meta.env.BASE_URL` devuelve `/tecnoboletin`
// (sin barra final). Para concatenar rutas seguras, almacenamos la barra final
// aquí una sola vez.
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');

// "Hoy" y "Triaje" apuntan siempre al último boletín publicado, que es el
// destino real que quiere el 90% de las visitas — antes había que pasar por
// el índice para llegar a la lectura del día.
const dates = await listDates();
const hoy = dates[0] ?? null;

const nav: { key: string; href: string; label: string; adminOnly?: boolean }[] = [
  { key: 'hoy', href: hoy ? `${base}enriquecido/${hoy}/` : `${base}enriquecido/`, label: 'Hoy' },
  { key: 'archivo', href: `${base}enriquecido/`, label: 'Archivo' },
  { key: 'triaje', href: hoy ? `${base}triaje/${hoy}/` : `${base}enriquecido/`, label: 'Triaje' },
  { key: 'grafo', href: `${base}grafo/`, label: 'Grafo' },
  { key: 'temas', href: `${base}temas/`, label: 'Temas' },
  { key: 'fuentes', href: `${base}fuentes/`, label: 'Fuentes' },
];

const mainClass =
  width === 'full'
    ? 'w-full'
    : width === 'wide'
      ? 'max-w-[1280px] mx-auto px-6 py-8 md:py-10'
      : 'max-w-5xl mx-auto px-6 py-10 md:py-14';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="Tecnoboletín" href={`${base}rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Tecnoboletín</title>
  </head>
  <body class="min-h-screen bg-bg text-text flex flex-col">
    <div class="brand-rule"></div>
    <header class="sticky top-0 z-50 border-b border-border bg-bg-raised/92 backdrop-blur">
      <div class="max-w-[1280px] mx-auto px-6 h-[52px] flex items-center justify-between gap-6">
        <a href={base} class="flex items-center gap-2.5 shrink-0 group" aria-label="Inicio de Tecnoboletín">
          <span class="csi-dot" aria-hidden="true"></span>
          <span class="crumb">
            <span class="hidden sm:inline">código sin siesta<span class="crumb__sep">/</span></span>
            <span class:list={[crumbs.length ? '' : 'crumb__here', 'group-hover:text-text transition-colors']}>tecnoboletín</span>
            {crumbs.map((c, i) => (
              <>
                <span class="crumb__sep">/</span>
                <span class:list={[i === crumbs.length - 1 && 'crumb__here']}>{c}</span>
              </>
            ))}
          </span>
        </a>
        <nav class="hidden md:flex gap-1 items-center -mr-2" aria-label="Secciones">
          {nav.map((item) => (
            <a href={item.href} class:list={['pill', item.key === activeNav && 'pill--on']}>
              {item.label}
            </a>
          ))}
          <a
            href={`${base}cuenta/`}
            class:list={[
              'ml-2 w-[26px] h-[26px] rounded-full border flex items-center justify-center font-mono text-[11px] transition-colors',
              activeNav === 'cuenta'
                ? 'border-accent text-accent'
                : 'border-border-strong text-muted-dim hover:text-text hover:border-accent-soft',
            ]}
            aria-label="Tu cuenta"
            title="Tu cuenta"
          >A</a>
        </nav>

        <!-- Menú móvil: <details> nativo, sin JS — el mismo patrón que los
             nodos de grafo/indice. Por debajo de `md` los 6 links + el
             prefijo "código sin siesta/" del logo no caben en una fila. -->
        <details class="relative md:hidden -mr-1">
          <summary
            class="list-none cursor-pointer w-8 h-8 rounded-full border border-border-strong text-muted-dim flex items-center justify-center transition-colors hover:text-text hover:border-accent-soft"
            aria-label="Abrir menú de secciones"
          >
            <span aria-hidden="true" class="text-base leading-none">☰</span>
          </summary>
          <nav
            class="absolute right-0 top-[calc(100%+10px)] w-52 rounded-xl border border-border-strong bg-bg-raised shadow-lg p-1.5 flex flex-col gap-0.5 z-50"
            aria-label="Secciones (móvil)"
          >
            {nav.map((item) => (
              <a href={item.href} class:list={['pill text-left', item.key === activeNav && 'pill--on']}>
                {item.label}
              </a>
            ))}
            <a href={`${base}cuenta/`} class:list={['pill text-left', activeNav === 'cuenta' && 'pill--on']}>
              Tu cuenta
            </a>
          </nav>
        </details>
      </div>
    </header>

    <main class:list={[mainClass, 'flex-1']}>
      <slot />
    </main>

    <footer class="border-t border-border mt-16">
      <div class="max-w-[1280px] mx-auto px-6 py-6 flex flex-col sm:flex-row gap-2 sm:justify-between mono-meta">
        <span>
          Hecho con <span class="text-accent">♥</span> por
          <a href="https://codigosinsiesta.com/" class="text-muted hover:text-accent-dim">Código Sin Siesta</a>
          · proyecto personal de Alejandro de la Fuente
        </span>
        <span>
          Astro 5 · {dates.length} boletines ·
          <a href={`${base}rss.xml`} class="text-muted hover:text-accent-dim">RSS</a>
        </span>
      </div>
    </footer>

  </body>
</html>
